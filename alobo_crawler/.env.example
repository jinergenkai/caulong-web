# Key AES-256 giải mã response ALOBO (decrypt.py dùng).
ALOBO_KEY=

# fetch_raw.py mặc định dùng Playwright để lấy chữ ký mới từ app thật.
# Tuỳ chọn: chỉ cần khi Chromium/Chrome không nằm ở vị trí mặc định.
# ALOBO_CHROME_PATH=/duong/dan/toi/chrome

# Fallback HTTP cũ, chỉ bật khi cần debug/revert. Thường không bền vì signature
# theo thời gian/browser; mặc định KHÔNG dùng dù key này tồn tại.
# ALOBO_FETCH_MODE=header
# ALOBO_X_USER_APP=
